datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Instructor {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  courses Course[]
}

model Course {
  id                        String   @id @default(cuid())
  instructorId              String
  name                      String
  code                      String
  term                      String
  defaultClassLengthMinutes Int      @default(60)
  createdAt                 DateTime @default(now())

  instructor         Instructor           @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  students           Student[]
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]
  timeLogs           InstructorTimeLog[]
}

model Student {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  email     String?
  createdAt DateTime @default(now())

  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendanceRecords   AttendanceRecord[]
  homeworkSubmissions HomeworkSubmission[]
  strategies          StudentStrategy[]
}

model AttendanceSession {
  id        String   @id @default(cuid())
  courseId  String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  course  Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  status    String   @default("PRESENT") // PRESENT, LATE, ABSENT
  updatedAt DateTime @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  dueDate     DateTime
  totalPoints Int      @default(100)
  createdAt   DateTime @default(now())

  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  status       String   @default("MISSING") // MISSING, SUBMITTED, GRADED
  grade        Float?
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model StudentStrategy {
  id            String   @id @default(cuid())
  studentId     String
  strategyNotes String
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model InstructorTimeLog {
  id            String   @id @default(cuid())
  courseId      String
  sessionDate   DateTime
  prepTimeHours Float    @default(0)
  contactHours  Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
